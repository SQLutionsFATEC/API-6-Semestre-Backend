# ==========================================
# Keycloak
# ==========================================
# Painel administrativo: http://localhost:8080 (usuário/senha abaixo)
KC_BOOTSTRAP_ADMIN_USERNAME=${KC_BOOTSTRAP_ADMIN_USERNAME:-admin}
KC_BOOTSTRAP_ADMIN_PASSWORD=${KC_BOOTSTRAP_ADMIN_PASSWORD:-admin}

# Banco de dados interno do Keycloak (separado do banco da aplicação)
KEYCLOAK_DB_USER=${KEYCLOAK_DB_USER:-keycloak}
KEYCLOAK_DB_PASSWORD=${KEYCLOAK_DB_PASSWORD:-keycloak}

# Utilizados pelo backend (django) para validar tokens e usar a Admin API
KEYCLOAK_URL=${KEYCLOAK_URL:-http://keycloak:8080}
KEYCLOAK_REALM=${KEYCLOAK_REALM:-sqlutions}
# Credenciais usadas pelo backend para obter token de administrador
# (mesmas do KC_BOOTSTRAP_ADMIN, do realm master)
KEYCLOAK_ADMIN_USERNAME=${KEYCLOAK_ADMIN_USERNAME:-admin}
KEYCLOAK_ADMIN_PASSWORD=${KEYCLOAK_ADMIN_PASSWORD:-admin}

# ==========================================
# Banco de Dados
# ==========================================
POSTGRES_USER=${POSTGRES_USER:-sqlutions}
POSTGRES_PASSWORD=${POSTGRES_PASSWORD:-senha_padrao}
POSTGRES_DB=${POSTGRES_DB:-api_db}

# ==========================================
# Backend
# ==========================================
DB_HOST=${DB_HOST:-postgres}
DB_PORT=${DB_PORT:-5432}
OLLAMA_HOST=${OLLAMA_HOST:-http://ollama:11434}
# se for rodar localmente
#OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=${OLLAMA_MODEL:-nomic-embed-text-v2-moe}

# Chave de criptografia do Django
DJANGO_SECRET_KEY=${DJANGO_SECRET_KEY:-chave_django}

# ==========================================
# Frontend 
# ==========================================
# Define qual branch do repositório do frontend o Docker deve baixar e compilar
FRONTEND_BRANCH=${FRONTEND_BRANCH:-develop-1}

# URL para o Next.js se comunicar com o Django localmente
NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL:-http://localhost:8000}
