[TEMPLATE]
# ==========================================
# Keycloak
# ==========================================
# Painel administrativo: http://localhost:8080 (usuário/senha abaixo)
KC_BOOTSTRAP_ADMIN_USERNAME=${KC_BOOTSTRAP_ADMIN_USERNAME:-admin}
KC_BOOTSTRAP_ADMIN_PASSWORD=${KC_BOOTSTRAP_ADMIN_PASSWORD:-admin}

# Banco de dados interno do Keycloak (separado do banco da aplicação)
KEYCLOAK_DB_USER=${KEYCLOAK_DB_USER:-keycloak}
KEYCLOAK_DB_PASSWORD=${KEYCLOAK_DB_PASSWORD:-keycloak}

# Utilizados pelo backend (django) para validar tokens e usar a Admin API
KEYCLOAK_URL=${KEYCLOAK_URL:-http://keycloak:8080}
KEYCLOAK_REALM=${KEYCLOAK_REALM:-sqlutions}
# Service account do client confidencial que acessa a Admin API (escopo do
# realm). O secret padrão existe apenas para o setup local: em produção,
# rotacione no Keycloak e injete por secret manager.
KEYCLOAK_BACKEND_CLIENT_ID=${KEYCLOAK_BACKEND_CLIENT_ID:-backend}
KEYCLOAK_BACKEND_CLIENT_SECRET=${KEYCLOAK_BACKEND_CLIENT_SECRET:-backend-secret}

# ==========================================
# Banco de Dados
# ==========================================
POSTGRES_USER=${POSTGRES_USER:-sqlutions}
POSTGRES_PASSWORD=${POSTGRES_PASSWORD:-senha_padrao}
POSTGRES_DB=${POSTGRES_DB:-api_db}

# ==========================================
# Banco de usuários deletados (tombstones)
# ==========================================
# Banco independente: restaurações de backup da aplicação/Keycloak nunca
# sobrescrevem esta lista. Em produção, prefira um servidor separado.
DELETED_USERS_DB_NAME=${DELETED_USERS_DB_NAME:-deleted_users_db}
DELETED_USERS_DB_USER=${DELETED_USERS_DB_USER:-${POSTGRES_USER:-sqlutions}}
DELETED_USERS_DB_PASSWORD=${DELETED_USERS_DB_PASSWORD:-${POSTGRES_PASSWORD:-senha_padrao}}
DELETED_USERS_DB_HOST=${DELETED_USERS_DB_HOST:-tombstone-db}
DELETED_USERS_DB_PORT=${DELETED_USERS_DB_PORT:-5432}

# ==========================================
# E-mail (comprovação de exclusão / LGPD)
# ==========================================
# Padrão: console do backend (desenvolvimento). Em produção, use SMTP.
EMAIL_BACKEND=${EMAIL_BACKEND:-django.core.mail.backends.console.EmailBackend}
EMAIL_HOST=${EMAIL_HOST:-smtp.example.com}
EMAIL_PORT=${EMAIL_PORT:-587}
EMAIL_HOST_USER=${EMAIL_HOST_USER:-}
EMAIL_HOST_PASSWORD=${EMAIL_HOST_PASSWORD:-}
EMAIL_USE_TLS=${EMAIL_USE_TLS:-true}
DEFAULT_FROM_EMAIL=${DEFAULT_FROM_EMAIL:-nao-responda@sqlutions.example.com}

# ==========================================
# Backend
# ==========================================
DB_HOST=${DB_HOST:-postgres}
DB_PORT=${DB_PORT:-5432}
OLLAMA_HOST=${OLLAMA_HOST:-http://ollama:11434}
# se for rodar localmente
#OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=${OLLAMA_MODEL:-nomic-embed-text-v2-moe}

# Chave de criptografia do Django
DJANGO_SECRET_KEY=${DJANGO_SECRET_KEY:-chave_django}

# ==========================================
# Frontend 
# ==========================================
# Define qual branch do repositório do frontend o Docker deve baixar e compilar
FRONTEND_BRANCH=${FRONTEND_BRANCH:-develop-1}

# URL para o Next.js se comunicar com o Django localmente
NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL:-http://localhost:8000}
